@'
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node
node_modules/
.next/
out/

# Env files
.env
.env.local

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Raw dataset (check its license before committing it)
data/raw/*
!data/raw/.gitkeep
'@ | Set-Content -Path .gitignore -Encoding ascii